# 이 파일을 ".env"로 복사한 뒤 사용할 키만 채우세요. .env는 git에 올라가지 않습니다.
# 키가 없어도 동작합니다(직무 추천·점검은 규칙+검색, 보완은 빈칸 채우기 틀).

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ChatGPT (OpenAI)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# auto(기본: Claude 키 → OpenAI 키 → 로컬 Ollama) | anthropic | openai | ollama | off
# 로컬 Ollama만 쓰려면 아래 두 줄의 # 을 지우세요(키 불필요, 데이터가 외부로 나가지 않음).
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=kanana2:3b

# PORT=5400
# EMBEDDINGS=on   # Ollama embeddinggemma 임베딩을 BM25와 섞어 검색(선택)
